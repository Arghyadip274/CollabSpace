# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-min-32-chars

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=collabspace
POSTGRES_PASSWORD=collabspace_dev
POSTGRES_DB=collabspace_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://collabspace:collabspace_dev@postgres:5432/collabspace_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=access-secret-change-me
JWT_REFRESH_SECRET=refresh-secret-change-me
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ─── Google Gemini AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─── CORS ────────────────────────────────────────────────────────────────────
# Must be a JSON list (a comma-separated string fails to parse)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Frontend ────────────────────────────────────────────────────────────────
# Backend origin used for the WebSocket (set in Vercel for production)
VITE_BACKEND_URL=http://localhost:8000
